{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null && (data.child('host').val() == auth.uid || data.child('status').val() == 'lobby' || data.child('players').child(auth.uid).exists())",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() == auth.uid && newData.child('status').val() == 'lobby') || data.child('host').val() == auth.uid)",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($room).child('status').val() == 'lobby'"
          }
        },
        "messages": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($room).child('status').val() == 'playing'"
          }
        }
      }
    }
  }
}
